; ctr64 GLideN64 backend vertex shader.
; Positions arrive in final PICA clip space: the CPU already applied GLideN64's vertex-shader
; math (viewport, quarter-pixel snap, screen-space modes, depth remap), so this only passes
; data through.
;   v0 = position (float4), v1 = color (ubyte4, 0..255), v2 = texcoord0 (float2), v3 = texcoord1 (float2)
;
; proj (pica_projective): the position is divided by w here and drawn with w = 1, so the PICA
; interpolates colour linearly on screen, as the N64 does (it interpolates perspective-correctly
; otherwise); texture unit 0 then runs in projection mode with texcoord0 = st / w and
; texcoord0w = 1 / w, which divides per pixel: still perspective-correct. Depth is z / w either
; way (z buffer mode).

.constf gconsts(0.00392156862745098, 1.0, 0.0, 0.0)
.alias  inv255 gconsts.xxxx
.alias  ones   gconsts.yyyy

.bool proj

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outtc1 texcoord1

.entry gfx_main

.proc gfx_main
	mul outclr, inv255, v1
	mov outtc1, v3
	ifu proj
		rcp r0.x, v0.w
		mul r1.xyz, r0.xxx, v0.xyz
		mov r1.w, ones
		mov outpos, r1
		mul outtc0, r0.xxxx, v2
		mov outtc0w, r0.x
	.else
		mov outpos, v0
		mov outtc0, v2
		mov outtc0w, ones
	.end
	end
.end
